{% block solver_comment_header %}
/* THIS FILE HAS BEEN AUTO-GENERATED BY DENGO.  DO NOT EDIT.

   Self-contained solver for the "{{ solver_name }}" network: no external
   ODE/numerical library is required.  Rate/cooling/gamma tables are read
   from a flat binary file ("{{ solver_name }}_tables.bin") with plain
   fread() -- no HDF5 dependency at build or run time.
*/
{% endblock %}
#ifndef {{ solver_name | upper }}_SOLVER_H
#define {{ solver_name | upper }}_SOLVER_H

#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define NSPECIES {{ network.required_species | length }}
#define DMAX(A, B) ((A) > (B) ? (A) : (B))
#define DMIN(A, B) ((A) < (B) ? (A) : (B))

/* Below this many cells in a batch, OpenMP's thread-team spawn/join
   overhead costs more than the parallel work saves -- e.g. on the
   machine this was tuned on, a single-cell call got ~300x *slower*
   under naive `#pragma omp parallel for` with no threshold. Every such
   pragma in this file (and in BE_chem_solve.C, which redefines this
   same constant since it's compiled standalone) is guarded with
   `if (nstrip > DENGO_OMP_MIN_CELLS)` so small batches -- a single cell,
   or a handful -- automatically stay serial. This value is an empirical
   round number from one machine, not a tuned optimum; if you're calling
   this at a consistently small or huge batch size, it's worth
   re-checking against your own hardware.  */
#define DENGO_OMP_MIN_CELLS 2048

{% block data_struct %}
typedef struct {{ solver_name }}_data {
    /* Shared temperature-bin grid for every rate/cooling/gamma table */
    double dbin;
    double idbin;
    double bounds[2];
    int nbins;

    /* number of independent chemical systems ("cells") batched together */
    int nstrip;

    /* redshift, only used for the CMB temperature floor in Compton
       cooling; not a full redshift-dependent-table backend (that's only
       needed for photoionization/photoheating, which this backend
       doesn't support). */
    double current_z;

    /* per-cell state, allocated to `nstrip` in {{ solver_name }}_setup_data */
    double *Ts;
    double *Tdef;
    double *dT;
    double *logTs;
    double *invTs;
    double *dTs_{{ network.energy_term.name }};

    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    double r_{{ name }}[{{ network.T | length }}];
    double *rs_{{ name }};
    double *drs_{{ name }};
    {%- endfor %}

    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    double c_{{ name }}_{{ name2 }}[{{ network.T | length }}];
    double *cs_{{ name }}_{{ name2 }};
    double *dcs_{{ name }}_{{ name2 }};
    {%- endfor %}
    {%- endfor %}

    {%- for sp in network.interpolate_gamma_species | sort %}
    double g_gamma{{ sp.name }}[{{ network.T | length }}];
    double g_dgamma{{ sp.name }}_dT[{{ network.T | length }}];
    double *gamma{{ sp.name }};
    double *dgamma{{ sp.name }}_dT;
    {%- endfor %}

    double reltol;
    double floor_value;
} {{ solver_name }}_data;
{% endblock %}

{{ solver_name }}_data *{{ solver_name }}_setup_data(const char *table_file, int nstrip);
void {{ solver_name }}_free_data({{ solver_name }}_data *data);

void {{ solver_name }}_interpolate_rates({{ solver_name }}_data *data, int nstrip);
void {{ solver_name }}_interpolate_gamma({{ solver_name }}_data *data, int i);
int {{ solver_name }}_calculate_temperature({{ solver_name }}_data *data,
                                            double *input, int nstrip, int nchem);

int calculate_rhs_{{ solver_name }}(double *input, double *rhs,
                                    int nstrip, int nchem, void *sdata);
int calculate_jacobian_{{ solver_name }}(double *input, double *Joutput,
                                         int nstrip, int nchem, void *sdata);
void ensure_electron_consistency(double *input, int nstrip, int nchem);

typedef int (*rhs_f)(double *, double *, int, int, void *);
typedef int (*jac_f)(double *, double *, int, int, void *);

int BE_chem_solve(rhs_f f, jac_f J, double *u, double dt, double *rtol,
                  double *atol, int nstrip, int nchem, double *scaling,
                  void *sdata, double *u0, double *s, double *gu, double *Ju);

/* Diagnostic info for BE_chem_solve's most recent failure, if any --
   see BE_chem_solve.C for field meanings (reason: 1=tolerance not met,
   2=NaN, 3=singular Jacobian). */
typedef struct {
    int occurred;
    int reason;
    int cell;
    int species_index;
    double value;
    double change;
    double atol;
    double rtol;
    double ratio;
} BE_chem_solve_diag;

BE_chem_solve_diag BE_chem_solve_last_failure();

#endif
