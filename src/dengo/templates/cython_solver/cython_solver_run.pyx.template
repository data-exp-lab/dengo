    """Compute T for one state without advancing the chemistry at all --
    useful for e.g. re-deriving T after manually rescaling densities
    (a compression step) before handing the state back to run_{{ solver_name }}."""
    cdef int n = NSPECIES
    cdef double *input = <double *> malloc(n * sizeof(double))
    for s_idx, name in enumerate(SPECIES_NAMES):
        input[s_idx] = state[name]

    if table_file is None:
        table_file = _DEFAULT_TABLE_FILE
    cdef bytes table_file_b = table_file.encode("utf-8")
    cdef char *table_file_c = table_file_b
    cdef {{ solver_name }}_data *data = {{ solver_name }}_setup_data(table_file_c, 1)
    data.current_z = redshift

    cdef int rv = {{ solver_name }}_calculate_temperature(data, input, 1, n)
    cdef double T = data.Ts[0]

    {{ solver_name }}_free_data(data)
    free(input)
    if rv != 0:
        raise RuntimeError("{{ solver_name }}_calculate_temperature failed (rv=%d)" % rv)
    return T


