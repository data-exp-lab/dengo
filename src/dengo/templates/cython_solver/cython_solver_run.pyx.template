def run_{{ solver_name }}(ics, double dtf, int niter=10000,
                          double reltol=1.0e-5, double floor_value=1.0e-20,
                          bint adaptive_step=True, bint intermediate=True,
                          double redshift=0.0, table_file=None):
    """Evolve the "{{ solver_name }}" network from `ics` for a time `dtf`.

    Parameters
    ----------
    ics : dict[str, ndarray]
        Initial number densities (cm^-3) for every species in
        SPECIES_NAMES, plus "ge" (specific internal energy, erg/g).
        All arrays share one shape: each element is an independent
        chemical system ("cell") integrated in lockstep.
    dtf : float
        Total time to integrate, in seconds.
    niter : int
        Maximum number of (adaptive) internal steps.
    reltol, floor_value : float
        Relative tolerance and abundance floor used by the Newton solver.
    adaptive_step : bool
        Grow the internal step by 1.1x after each success, halve it on
        failure (down to 1e-15 of dtf, at which point integration stops).
    intermediate : bool
        If True, also return the full (cell, niter) trajectory.
    redshift : float
        Only used for the CMB temperature floor in Compton cooling.
    table_file : str, optional
        Path to the rate table binary; defaults to the one written next
        to this module.

    Returns
    -------
    (final, trajectory_or_None) : (dict[str, ndarray], dict or None)
    """
    cdef int dims = int(np.asarray(ics["{{ network.energy_term.name }}"]).shape[0])
    cdef int n = NSPECIES
    cdef int i, s_idx, it

    cdef double *input = <double *> malloc(dims * n * sizeof(double))
    cdef double *prev   = <double *> malloc(dims * n * sizeof(double))
    cdef double *scale  = <double *> malloc(dims * n * sizeof(double))
    cdef double *atol   = <double *> malloc(dims * n * sizeof(double))
    cdef double *rtol   = <double *> malloc(dims * n * sizeof(double))
    cdef double *u0     = <double *> malloc(dims * n * sizeof(double))
    cdef double *s      = <double *> malloc(dims * n * sizeof(double))  # per-cell now (OpenMP-parallel Newton update)
    cdef double *gu     = <double *> malloc(dims * n * sizeof(double))
    cdef double *Ju     = <double *> malloc(dims * n * n * sizeof(double))

    cdef double[::1] arr_view
    for s_idx, name in enumerate(SPECIES_NAMES):
        arr_view = np.ascontiguousarray(ics[name], dtype=np.float64).reshape(-1)
        for i in range(dims):
            input[i * n + s_idx] = arr_view[i]

    if table_file is None:
        table_file = _DEFAULT_TABLE_FILE
    cdef bytes table_file_b = table_file.encode("utf-8")
    cdef char *table_file_c = table_file_b

    cdef {{ solver_name }}_data *data = {{ solver_name }}_setup_data(table_file_c, dims)
    data.current_z = redshift

    ensure_electron_consistency(input, dims, n)
    for i in range(dims * n):
        atol[i] = floor_value * reltol
        rtol[i] = reltol
        # BE_chem_solve normalizes by 1/scale internally, so scale must
        # never be zero -- and an exactly-zero initial abundance (e.g. no
        # He+ / He++ / H2 yet) is the common case, not an edge case.
        scale[i] = max(abs(input[i]), floor_value)
        prev[i] = input[i]

    traj_dict = {}
    T_traj = None
    t_traj = None
    ok_traj = None
    if intermediate:
        traj_dict = {name: np.zeros((dims, niter)) for name in SPECIES_NAMES}
        T_traj = np.zeros((dims, niter))
        t_traj = np.zeros(niter)
        ok_traj = np.zeros(niter, dtype=bool)

    cdef double dt = dtf / niter
    cdef double ttot = 0.0
    cdef int rv
    it = 0
    while it < niter and ttot < dtf:
        rv = BE_chem_solve(calculate_rhs_{{ solver_name }}, calculate_jacobian_{{ solver_name }},
                            input, dt, rtol, atol, dims, n, scale,
                            <void *> data, u0, s, gu, Ju)
        for i in range(dims * n):
            if input[i] < 0:
                rv = 1
                break
        if rv == 0:
            ttot += dt
            for i in range(dims * n):
                if input[i] < floor_value:
                    input[i] = floor_value
                prev[i] = input[i]
                scale[i] = max(abs(input[i]), floor_value)
            if intermediate:
                for i in range(dims):
                    for s_idx, name in enumerate(SPECIES_NAMES):
                        traj_dict[name][i, it] = input[i * n + s_idx]
                    T_traj[i, it] = data.Ts[i]
                t_traj[it] = ttot
                ok_traj[it] = True
            if adaptive_step and ttot < dtf:
                dt = min(dt * 1.1, dtf - ttot)
            it += 1
        else:
            dt /= 2.0
            for i in range(dims * n):
                input[i] = prev[i]
                scale[i] = max(abs(prev[i]), floor_value)
            if dt < 1.0e-15 * dtf:
                break

    final = {}
    for s_idx, name in enumerate(SPECIES_NAMES):
        final[name] = np.array([input[i * n + s_idx] for i in range(dims)])
    final["T"] = np.array([data.Ts[i] for i in range(dims)])
    final["t"] = ttot
    final["converged"] = (ttot >= dtf)

    trajectory = None
    if intermediate:
        trajectory = {name: traj_dict[name][:, :it] for name in SPECIES_NAMES}
        trajectory["T"] = T_traj[:, :it]
        trajectory["t"] = t_traj[:it]
        trajectory["successful"] = ok_traj[:it]

    {{ solver_name }}_free_data(data)
    free(input); free(prev); free(scale); free(atol); free(rtol)
    free(u0); free(s); free(gu); free(Ju)

    return final, trajectory


