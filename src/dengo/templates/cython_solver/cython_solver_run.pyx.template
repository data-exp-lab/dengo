def run_{{ solver_name }}(ics, double dtf, int niter=10000,
                          double reltol=1.0e-5, double floor_value=1.0e-20,
                          bint adaptive_step=True, bint intermediate=True,
                          double redshift=0.0, table_file=None):
    """Evolve the "{{ solver_name }}" network from `ics` for a time `dtf`,
    as a single one-shot call. If you'll be calling into this solver
    repeatedly with externally-updated state (a free-fall/collapse
    driver, coupling to a hydro code's per-step chemistry update, ...),
    use `Solver` instead and keep it around across calls -- this
    function creates one, uses it once, and throws it away, which means
    re-reading the rate tables off disk and re-allocating every scratch
    buffer every single call.

    Parameters
    ----------
    ics : dict[str, ndarray]
        Initial number densities (cm^-3) for every species in
        SPECIES_NAMES, plus "ge" (specific internal energy, erg/g).
        All arrays share one shape: each element is an independent
        chemical system ("cell") integrated in lockstep.
    dtf : float
        Total time to integrate, in seconds.
    niter : int
        Maximum number of (adaptive) internal steps.
    reltol, floor_value : float
        Relative tolerance and abundance floor used by the Newton solver.
    adaptive_step : bool
        Grow the internal step by 1.1x after each success, halve it on
        failure (down to 1e-15 of dtf, at which point integration stops).
    intermediate : bool
        If True, also return the full (cell, niter) trajectory.
    redshift : float
        Only used for the CMB temperature floor in Compton cooling.
    table_file : str, optional
        Path to the rate table binary; defaults to the one written next
        to this module.

    Returns
    -------
    (final, trajectory_or_None) : (dict[str, ndarray], dict or None)
    """
    cdef int dims = int(np.asarray(ics["{{ network.energy_term.name }}"]).shape[0])
    solver = Solver(dims, table_file=table_file, redshift=redshift)
    try:
        return solver.step(ics, dtf, niter=niter, reltol=reltol, floor_value=floor_value,
                            adaptive_step=adaptive_step, intermediate=intermediate)
    finally:
        solver.close()


