    """Evaluate the analytic Jacobian once, for one cell, as a
    {(row_species, col_species): d(row)/d(col)} dict. One-shot
    convenience wrapper; see `Solver` if you're calling this repeatedly."""
    solver = Solver(1, table_file=table_file, redshift=redshift)
    try:
        return solver.evaluate_jacobian(state)
    finally:
        solver.close()
