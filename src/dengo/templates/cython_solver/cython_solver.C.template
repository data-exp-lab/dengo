{% block setup_data %}
{{ solver_name }}_data *{{ solver_name }}_setup_data(const char *table_file, int nstrip)
{
    {{ solver_name }}_data *data = ({{ solver_name }}_data *) malloc(sizeof({{ solver_name }}_data));

    data->nstrip = nstrip;
    data->reltol = 1.0e-5;
    data->floor_value = 1.0e-20;
    data->current_z = 0.0;

    data->bounds[0] = {{ network.T_bounds[0] }};
    data->bounds[1] = {{ network.T_bounds[1] }};
    data->nbins = {{ network.T | length }} - 1;
    data->dbin  = (log(data->bounds[1]) - log(data->bounds[0])) / data->nbins;
    data->idbin = 1.0 / data->dbin;

    data->Ts    = (double *) malloc(nstrip * sizeof(double));
    data->Tdef  = (double *) malloc(nstrip * sizeof(double));
    data->dT    = (double *) malloc(nstrip * sizeof(double));
    data->logTs = (double *) malloc(nstrip * sizeof(double));
    data->invTs = (double *) malloc(nstrip * sizeof(double));
    data->dTs_{{ network.energy_term.name }} = (double *) malloc(nstrip * sizeof(double));
    for (int i = 0; i < nstrip; i++) {
        data->Ts[i] = 1000.0;
        data->logTs[i] = log(1000.0);
        data->invTs[i] = 1.0 / 1000.0;
    }

    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    data->rs_{{ name }}  = (double *) malloc(nstrip * sizeof(double));
    data->drs_{{ name }} = (double *) malloc(nstrip * sizeof(double));
    {%- endfor %}

    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    data->cs_{{ name }}_{{ name2 }}  = (double *) malloc(nstrip * sizeof(double));
    data->dcs_{{ name }}_{{ name2 }} = (double *) malloc(nstrip * sizeof(double));
    {%- endfor %}
    {%- endfor %}

    {%- for sp in network.interpolate_gamma_species | sort %}
    data->gamma{{ sp.name }}     = (double *) malloc(nstrip * sizeof(double));
    data->dgamma{{ sp.name }}_dT = (double *) malloc(nstrip * sizeof(double));
    {%- endfor %}

    {{ solver_name }}_read_tables(data, table_file);
    return data;
}

void {{ solver_name }}_free_data({{ solver_name }}_data *data)
{
    free(data->Ts); free(data->Tdef); free(data->dT);
    free(data->logTs); free(data->invTs);
    free(data->dTs_{{ network.energy_term.name }});
    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    free(data->rs_{{ name }}); free(data->drs_{{ name }});
    {%- endfor %}
    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    free(data->cs_{{ name }}_{{ name2 }}); free(data->dcs_{{ name }}_{{ name2 }});
    {%- endfor %}
    {%- endfor %}
    {%- for sp in network.interpolate_gamma_species | sort %}
    free(data->gamma{{ sp.name }}); free(data->dgamma{{ sp.name }}_dT);
    {%- endfor %}
    free(data);
}
{% endblock %}

{% block read_tables %}
/*
   Rate/cooling/gamma tables are stored as one flat binary file of
   concatenated little-endian doubles, in exactly the order they are
   fread() here.  Written by ChemicalNetwork._write_solver_tables_bin --
   see that method for the matching write order.
*/
static void {{ solver_name }}_read_tables({{ solver_name }}_data *data, const char *table_file)
{
    const char *filename = table_file ? table_file : "{{ solver_name }}_tables.bin";
    FILE *f = fopen(filename, "rb");
    if (f == NULL) {
        fprintf(stderr, "{{ solver_name }}: could not open rate table file '%s'\n", filename);
        exit(1);
    }
    size_t n = {{ network.T | length }};
    size_t nread = 0;
    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    nread += fread(data->r_{{ name }}, sizeof(double), n, f);
    {%- endfor %}
    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    nread += fread(data->c_{{ name }}_{{ name2 }}, sizeof(double), n, f);
    {%- endfor %}
    {%- endfor %}
    {%- for sp in network.interpolate_gamma_species | sort(attribute="name", case_sensitive=true) %}
    nread += fread(data->g_gamma{{ sp.name }}, sizeof(double), n, f);
    nread += fread(data->g_dgamma{{ sp.name }}_dT, sizeof(double), n, f);
    {%- endfor %}
    fclose(f);
    (void) nread;
}
{% endblock %}

{% block interpolate_rates %}
/* Every cell is independent (no cross-cell terms anywhere in this
   network), so this -- like calculate_rhs/calculate_jacobian/
   calculate_temperature/ensure_electron_consistency below -- parallelizes
   trivially over cells with OpenMP. Built without -fopenmp, the #pragma
   lines are just ignored and this runs serially. */
void {{ solver_name }}_interpolate_rates({{ solver_name }}_data *data, int nstrip)
{
    double lb = log(data->bounds[0]);
    #pragma omp parallel for if(nstrip > DENGO_OMP_MIN_CELLS)
    for (int i = 0; i < nstrip; i++) {
        int bin_id = (int) (data->idbin * (data->logTs[i] - lb));
        if (bin_id <= 0) bin_id = 0;
        else if (bin_id >= data->nbins) bin_id = data->nbins - 1;
        double t1 = lb + bin_id * data->dbin;
        double t2 = lb + (bin_id + 1) * data->dbin;
        data->Tdef[i] = (data->logTs[i] - t1) / (t2 - t1);
        data->dT[i] = t2 - t1;

        {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
        data->rs_{{ name }}[i] = data->r_{{ name }}[bin_id] +
            data->Tdef[i] * (data->r_{{ name }}[bin_id + 1] - data->r_{{ name }}[bin_id]);
        data->drs_{{ name }}[i] = (data->r_{{ name }}[bin_id + 1] - data->r_{{ name }}[bin_id])
            / data->dT[i] * data->invTs[i];
        {%- endfor %}

        {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
        {%- for name2 in action.tables | sort(case_sensitive=true) %}
        data->cs_{{ name }}_{{ name2 }}[i] = data->c_{{ name }}_{{ name2 }}[bin_id] +
            data->Tdef[i] * (data->c_{{ name }}_{{ name2 }}[bin_id + 1] - data->c_{{ name }}_{{ name2 }}[bin_id]);
        data->dcs_{{ name }}_{{ name2 }}[i] = (data->c_{{ name }}_{{ name2 }}[bin_id + 1] - data->c_{{ name }}_{{ name2 }}[bin_id])
            / data->dT[i] * data->invTs[i];
        {%- endfor %}
        {%- endfor %}
    }
}
{% endblock %}

{% block interpolate_gamma %}
/* Called per-cell (from calculate_temperature's own parallel loop, among
   other places), not itself a loop over cells -- nothing to parallelize
   here, and it's already thread-safe (every array access is at the
   caller-supplied index i, no cell shares state with another). */
void {{ solver_name }}_interpolate_gamma({{ solver_name }}_data *data, int i)
{
    double lb = log(data->bounds[0]);
    int bin_id = (int) (data->idbin * (data->logTs[i] - lb));
    if (bin_id <= 0) bin_id = 0;
    else if (bin_id >= data->nbins) bin_id = data->nbins - 1;
    double t1 = lb + bin_id * data->dbin;
    double t2 = lb + (bin_id + 1) * data->dbin;
    data->Tdef[i] = (data->logTs[i] - t1) / (t2 - t1);
    data->dT[i] = t2 - t1;

    {%- for sp in network.interpolate_gamma_species | sort %}
    data->gamma{{ sp.name }}[i] = data->g_gamma{{ sp.name }}[bin_id] +
        data->Tdef[i] * (data->g_gamma{{ sp.name }}[bin_id + 1] - data->g_gamma{{ sp.name }}[bin_id]);
    data->dgamma{{ sp.name }}_dT[i] = data->g_dgamma{{ sp.name }}_dT[bin_id] +
        data->Tdef[i] * (data->g_dgamma{{ sp.name }}_dT[bin_id + 1] - data->g_dgamma{{ sp.name }}_dT[bin_id]);
    {%- endfor %}
}
{% endblock %}

{% block calculate_temperature %}
int {{ solver_name }}_calculate_temperature({{ solver_name }}_data *data,
                                            double *input, int nstrip, int nchem)
{
    /* had_error is a reduction, not a per-cell early-return: a plain
       `return 1` from inside an OpenMP-parallelized loop isn't allowed
       (the loop has to run to completion across all threads), so a
       failing cell instead sets had_error and simply stops updating its
       own Ts -- the caller only ever looks at the overall 0/1 result, so
       leaving that one cell's Ts at whatever it last was is harmless:
       the whole step gets thrown away and retried at a smaller dt. */
    int had_error = 0;
    #pragma omp parallel for if(nstrip > DENGO_OMP_MIN_CELLS) reduction(+:had_error)
    for (int i = 0; i < nstrip; i++) {
        double dge_dT;
        {%- for species in network.required_species | sort %}
        double {{ species.name }};
        {%- endfor %}
        {%- if network.interpolate_gamma_species | length > 0 %}
        {%- for sp in network.interpolate_gamma_species | sort %}
        double gamma{{ sp.name }}, dgamma{{ sp.name }}_dT, _gamma{{ sp.name }}_m1;
        {%- endfor %}
        double dge, T, Tnew, Tdiff;
        int count;
        {%- endif %}
        double gamma = 5.0 / 3.0;
        double _gamma_m1 = 1.0 / (gamma - 1.0);
        double kb = 1.3806504e-16; /* Boltzmann constant [erg/K] */
        double mh = 1.66054e-24;   /* atomic mass unit [g] */
        double density;

        int j = i * nchem;
        {%- for species in network.ode_species | sort %}
        {{ species.name }} = input[j];
        /* A mid-Newton-sweep trial guess can transiently go negative;
           floor it here rather than letting log(negative density) or
           similar poison the persistent data->Ts cache -- calculate_rhs
           / calculate_jacobian still reject the overall step via their
           own species < 0 check, this only protects the temperature
           solve itself. */
        if ({{ species.name }} < data->floor_value) {{ species.name }} = data->floor_value;
        j++;
        {%- endfor %}
        {%- for species in network.equilibrium_species | sort %}
        {{ species.name }} = 0.0;
        {%- endfor %}
        density = {{ network.print_mass_density() }};

        {%- if network.interpolate_gamma_species | length > 0 %}
        /* gamma depends on T (H2 roto-vibrational states), so T has to be
           found by Newton iteration on the implicit ge(T) relation. */
        T = data->Ts[i];
        Tnew = T * 1.1;
        Tdiff = Tnew - T;
        count = 0;
        {
            int cell_ok = 1;
            while (fabs(Tdiff / Tnew) > 1.0e-8) {
                T = data->Ts[i];
                {{ solver_name }}_interpolate_gamma(data, i);
                {%- for sp in network.interpolate_gamma_species | sort %}
                gamma{{ sp.name }} = data->gamma{{ sp.name }}[i];
                dgamma{{ sp.name }}_dT = data->dgamma{{ sp.name }}_dT[i];
                _gamma{{ sp.name }}_m1 = 1.0 / (gamma{{ sp.name }} - 1.0);
                {%- endfor %}
                dge_dT = {{ network.temperature_calculation(derivative_dge_dT=True) }};
                dge = {{ network.temperature_calculation(get_dge=True) }};
                Tnew = T - dge / dge_dT;
                data->Ts[i] = Tnew;
                Tdiff = fabs(T - Tnew);
                count += 1;
                if (count > 100) {
                    cell_ok = 0;
                    break;
                }
            }
            if (!cell_ok) {
                had_error = 1;
            } else {
                data->Ts[i] = Tnew;
            }
        }
        {%- else %}
        data->Ts[i] = {{ network.temperature_calculation() }};
        {%- endif %}

        if (data->Ts[i] < data->bounds[0]) data->Ts[i] = data->bounds[0];
        else if (data->Ts[i] > data->bounds[1]) data->Ts[i] = data->bounds[1];
        data->logTs[i] = log(data->Ts[i]);
        data->invTs[i] = 1.0 / data->Ts[i];

        dge_dT = {{ network.temperature_calculation(derivative_dge_dT=True) }};
        data->dTs_{{ network.energy_term.name }}[i] = 1.0 / dge_dT;
    }
    return had_error ? 1 : 0;
}
{% endblock %}

{% block calculate_rhs %}
int calculate_rhs_{{ solver_name }}(double *input, double *rhs, int nstrip, int nchem, void *sdata)
{
    {{ solver_name }}_data *data = ({{ solver_name }}_data *) sdata;
    if ({{ solver_name }}_calculate_temperature(data, input, nstrip, nchem) != 0) return 1;
    {{ solver_name }}_interpolate_rates(data, nstrip);

    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    double *{{ name }} = data->rs_{{ name }};
    {%- endfor %}
    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    double *{{ name }}_{{ name2 }} = data->cs_{{ name }}_{{ name2 }};
    {%- endfor %}
    {%- endfor %}
    double z = data->current_z;

    /* see calculate_temperature's comment on had_error+continue: a
       failing cell just leaves its slice of rhs[] untouched (stale from
       the previous Newton sweep) and moves on -- fine, since the caller
       discards the whole rhs[] buffer the moment this returns nonzero. */
    int had_error = 0;
    #pragma omp parallel for if(nstrip > DENGO_OMP_MIN_CELLS) reduction(+:had_error)
    for (int i = 0; i < nstrip; i++) {
        {%- for species in network.required_species | sort %}
        double {{ species.name }};
        {%- endfor %}
        double T;
        double mh = 1.67e-24;
        double mdensity;

        int j = i * nchem;
        T = data->Ts[i];
        {%- for species in network.required_species | sort %}
        {{ species.name }} = input[j];
        if ({{ species.name }} < 0.0) { had_error = 1; continue; }
        j++;
        {%- endfor %}
        mdensity = ({{ network.print_mass_density() }}) * mh;
        {%- if "cie_cooling" in network.cooling_actions %}
        double tau = fmax(pow(mdensity / 3.3e-8, 2.8), 1.0e-5);
        double cie_optical_depth_approx = fmin(1.0, (1.0 - exp(-tau)) / tau);
        {%- endif %}
        {%- if "gloverabel08" in network.cooling_actions %}
        double h2_optical_depth_approx = fmin(1.0, pow(mdensity / 1.34e-14, -0.45));
        {%- endif %}

        j = i * nchem;
        {%- for species in network.required_species | sort %}
        {{ network.print_ccode(species, assign_to="rhs[j]") }}
        {%- if species.name == "ge" %}
        rhs[j] /= mdensity;
        {%- endif %}
        /* Checked here, inline, rather than as a second full-array pass
           after this loop (the previous version's `for (i=0;
           i<nchem*nstrip; i++) if (rhs[i]!=rhs[i]) return 1;`) -- that
           loop had no OpenMP pragma of its own, so at grid scale it was
           a fully serial re-scan of the whole rhs[] array on every
           single calculate_rhs call, right after a parallel loop that
           had just computed (and already had hot in cache) the exact
           same values. See NOTES.md. */
        if (rhs[j] != rhs[j]) { had_error = 1; continue; }
        j++;
        {%- endfor %}
    }
    if (had_error) return 1;
    return 0;
}
{% endblock %}

{% block calculate_jacobian %}
int calculate_jacobian_{{ solver_name }}(double *input, double *Joutput, int nstrip, int nchem, void *sdata)
{
    {{ solver_name }}_data *data = ({{ solver_name }}_data *) sdata;

    double *T{{ network.energy_term.name }} = data->dTs_{{ network.energy_term.name }};
    {%- for name, rxn in network.reactions | dictsort(case_sensitive=true) %}
    double *{{ name }} = data->rs_{{ name }};
    double *r{{ name }} = data->drs_{{ name }};
    {%- endfor %}
    {%- for name, action in network.cooling_actions | dictsort(case_sensitive=true) %}
    {%- for name2 in action.tables | sort(case_sensitive=true) %}
    double *{{ name }}_{{ name2 }} = data->cs_{{ name }}_{{ name2 }};
    double *r{{ name }}_{{ name2 }} = data->dcs_{{ name }}_{{ name2 }};
    {%- endfor %}
    {%- endfor %}
    double z = data->current_z;

    int had_error = 0;
    #pragma omp parallel for if(nstrip > DENGO_OMP_MIN_CELLS) reduction(+:had_error)
    for (int i = 0; i < nstrip; i++) {
        {%- for species in network.required_species | sort %}
        double {{ species.name }};
        {%- endfor %}
        double T;
        double mh = 1.67e-24;
        double mdensity;

        int j = i * nchem;
        T = data->Ts[i];
        {%- for species in network.required_species | sort %}
        {{ species.name }} = input[j];
        if ({{ species.name }} < 0.0) { had_error = 1; continue; }
        j++;
        {%- endfor %}
        mdensity = ({{ network.print_mass_density() }}) * mh;
        {%- if "cie_cooling" in network.cooling_actions %}
        double tau = fmax(pow(mdensity / 3.3e-8, 2.8), 1.0e-5);
        double cie_optical_depth_approx = fmin(1.0, (1.0 - exp(-tau)) / tau);
        {%- endif %}
        {%- if "gloverabel08" in network.cooling_actions %}
        double h2_optical_depth_approx = fmin(1.0, pow(mdensity / 1.34e-14, -0.45));
        {%- endif %}

        j = i * nchem * nchem;
        {%- for s1 in network.required_species | sort %}
        {%- for s2 in network.required_species | sort %}
        {{ network.print_jacobian_component(s2, s1, assign_to="Joutput[j]") }}
        {%- if s2.name == network.energy_term.name %}
        Joutput[j] /= mdensity;
        {%- endif %}
        {%- if s1.name == network.energy_term.name %}
        Joutput[j] *= T{{ network.energy_term.name }}[i];
        {%- endif %}
        j++;
        {%- endfor %}
        {%- endfor %}
    }
    return had_error ? 1 : 0;
}
{% endblock %}

{% block ensure_electron_consistency %}
void ensure_electron_consistency(double *input, int nstrip, int nchem)
{
    #pragma omp parallel for if(nstrip > DENGO_OMP_MIN_CELLS)
    for (int i = 0; i < nstrip; i++) {
        {%- for species in network.required_species | sort %}
        double {{ species.name }};
        {%- endfor %}
        int j = i * nchem;
        double total_e = 0.0;
        int e_idx = -1;
        {%- for species in network.required_species | sort %}
        {{ species.name }} = input[j];
        {%- if species.name != "ge" and species.name != "de" %}
        total_e += {{ species.name }} * {{ species.free_electrons }};
        {%- endif %}
        {%- if species.name == "de" %}
        e_idx = j;
        {%- endif %}
        j++;
        {%- endfor %}
        if (e_idx >= 0) input[e_idx] = total_e;
    }
}
{% endblock %}
