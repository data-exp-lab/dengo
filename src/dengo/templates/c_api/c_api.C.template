                    if (first > 0.0 && ctx->opts.error_tolerance > 0.0) sc->f0_valid = 1;
                }
                if (!(first > 0.0)) first = ctx->opts.first_step_fraction * dt;
                if (!sc->f0_valid) reset_temperature_guess(data);
                double ttot = {{ solver_name }}_advance(data, sc, u, 1, dt, ctx->opts.niter,
                                                        first, ctx->opts.error_tolerance,
                                                        ctx->opts.reltol, ctx->opts.floor_value,
                                                        1, NULL, NULL, NULL);
                if (ttot < dt) failed++;
                for (int f = 0; f < N_FIELDS; f++) grid->fields[f][idx] = u[f] / grid->to_cgs[f];
            }
            accepted += sc->n_accepted;
            rejected += sc->n_rejected;
            quiet += sc->n_quiet;
            {{ solver_name }}_free_scratch(sc);
            {{ solver_name }}_free_data(data);
