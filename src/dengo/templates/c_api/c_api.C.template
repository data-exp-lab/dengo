/* First sub-step for one cell (state u, cgs): min(dt, factor * shortest
   e-folding time over the energy and every species above 1e-6 of the
   total number density), from one RHS evaluation. Returns <= 0 if the
   RHS can't be evaluated (the caller then falls back). `rhs` is scratch
   space for NSPECIES doubles. */
static double timescale_first_step({{ solver_name }}_data *data, double *u, double *rhs,
                                   double dt, double factor)
{
    const int ige = {{ solver_name | upper }}_FIELD_{{ network.energy_term.name }};
    if (calculate_rhs_{{ solver_name }}(u, rhs, 1, N_FIELDS, (void *) data) != 0) return -1.0;
    double ntot = 0.0;
    for (int f = 0; f < N_FIELDS; f++) if (f != ige) ntot += u[f];
    double tmin = HUGE_VAL;
    for (int f = 0; f < N_FIELDS; f++) {
        if (f != ige && !(u[f] > 1.0e-6 * ntot)) continue;
        if (rhs[f] != 0.0) {
            double t = fabs(u[f] / rhs[f]);
            if (t < tmin) tmin = t;
        }
    }
    return fmin(dt, factor * tmin);
}

static inline void gather(const {{ solver_name }}_grid *grid, long idx, double *u)
{
