            {{ solver_name }}_scratch *sc = {{ solver_name }}_alloc_scratch(1);
            sc->allow_quiet = ctx->opts.quiet_path;
            sc->coupled_filter = ctx->opts.coupled_error_filter;
            double u[N_FIELDS];
            #pragma omp for schedule(dynamic, 16)
            for (long c = 0; c < r.ncell; c++) {
                long idx = cell_index(&r, c);
                gather(grid, idx, u);
                /* _advance starts by making e- consistent; do it first so
                   the first-step probe's RHS is the RHS at the state
                   _advance integrates from, and hand it over (one RHS
                   evaluation per cell instead of two). */
