/* Interior-cell iteration: cell c (0 <= c < ncell) of the interior maps
   to array index index(c). */
typedef struct {
    long ni, nj, nk, ncell;
    long is, js, ks;
    long nx, ny;
} cell_range;

static int make_range(const {{ solver_name }}_grid *grid, cell_range *r)
{
    if (grid == NULL || grid->grid_rank < 1 || grid->grid_rank > 3) return -1;
    if (grid->grid_dimension == NULL || grid->grid_start == NULL || grid->grid_end == NULL) return -1;
    long dim[3] = {1, 1, 1}, start[3] = {0, 0, 0}, end[3] = {0, 0, 0};
    for (int d = 0; d < grid->grid_rank; d++) {
        dim[d] = grid->grid_dimension[d];
        start[d] = grid->grid_start[d];
        end[d] = grid->grid_end[d];
        if (start[d] < 0 || end[d] >= dim[d]) return -1;
    }
    r->nx = dim[0]; r->ny = dim[1];
    r->is = start[0]; r->js = start[1]; r->ks = start[2];
    r->ni = end[0] - start[0] + 1;
    r->nj = end[1] - start[1] + 1;
    r->nk = end[2] - start[2] + 1;
    if (r->ni < 0) r->ni = 0;
    if (r->nj < 0) r->nj = 0;
    if (r->nk < 0) r->nk = 0;
    r->ncell = r->ni * r->nj * r->nk;
    return 0;
}

static inline long cell_index(const cell_range *r, long c)
{
    long i = r->is + c % r->ni;
    long j = r->js + (c / r->ni) % r->nj;
    long k = r->ks + c / (r->ni * r->nj);
    return i + r->nx * (j + r->ny * k);
}

