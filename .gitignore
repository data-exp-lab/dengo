# Python / uv
__pycache__/
*.py[cod]
*.egg-info/
.venv/
uv.lock.tmp
.pytest_cache/
.ruff_cache/

# Build artifacts
build/
dist/
*.so
*.o

# Generated solvers (output of ChemicalNetwork.write_cython_solver /
# solver_build.build_solver -- by convention these always land in a
# directory prefixed with "_", e.g. examples/_primordial_network_build/)
examples/_*/
**/_build/

# Editors / notebooks
.ipynb_checkpoints/
.vscode/
.idea/

# OS
.DS_Store

# Locally-extracted HDF5 dev files (for building Grackle to compare
# against, without a system-wide apt install -- see NOTES.md)
.grackle_deps/
.grackle/
.grackle_compare/.venv/
.grackle_compare/*.json
.grackle_compare/_dengo_build/
.grackle_compare/__pycache__/
.grackle_compare/c_bench/_link/
.grackle_compare/c_bench/grackle_bench
.grackle_compare/c_bench/dengo_bench

# WASM build's generated C++ source (regenerated by wasm/build.sh);
# dengo_wasm.js/.wasm ARE committed (see wasm/README.md)
wasm/_build/
